rules_version = '2';

// Modelo de datos (una sesión por charla: devfest-lima-2026-genui y devfest-lima-2026-agentes):
//   sessions/{sid}                  ← slide actual, pregunta abierta, resultados y podio. Solo la presentadora escribe.
//   sessions/{sid}/private/answers  ← respuestas correctas del podio: SOLO la presentadora lee y escribe
//   sessions/{sid}/names/{key}      ← reserva de apodo (único por sesión; si se repite, la app agrega "2", "3"…)
//   sessions/{sid}/players/{uid}    ← apodo (generado, no texto libre)
//   sessions/{sid}/votes/{uid}      ← { q1, q1At, … } — qNAt = hora del servidor (puntaje justo y no editable)
//   sessions/{sid}/reactions/{uid}  ← última reacción enviada (limitada a 1 cada ~0,8 s)
//   sessions/{sid}/avatares/{uid}   ← avatar limeño + su pelícano, publicado en el muro (solo opciones).
//                                     El deck de una charla LEE los avatares de la otra para el bono +200.
//   sessions/{sid}/questions/{id}   ← dudas del público: SOLO la presentadora las lee (nada de texto libre en el proyector)
//
// Las NOTAS de cada asistente nunca salen de su celular: no hay colección para ellas.
// Todo el público entra con Auth anónima: no pedimos datos personales.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cambia este id por el de quien presenta (GET https://api.github.com/users/<login> → "id").
    function isPresenter() {
      return request.auth != null
        && request.auth.token.firebase.identities.keys().hasAny(['github.com'])
        && request.auth.token.firebase.identities['github.com'][0] == '4331491';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function smallInt(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    match /sessions/{sid} {
      allow read: if true;
      allow write: if isPresenter();

      // Respuestas correctas: privadas. Nadie del público puede leerlas (ni con DevTools).
      match /private/{docId} {
        allow read, write: if isPresenter();
      }

      // Apodos únicos: el primero que lo crea se lo queda (sin update; solo la presentadora
      // borra, al vaciar la sesión antes de empezar).
      match /names/{key} {
        allow read: if true;
        allow delete: if isPresenter();
        allow create: if request.auth != null && onlyKeys(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && key.size() <= 40;
      }

      // La hora de entrada (bono "llegar a tiempo") es la del servidor al crear y no se puede cambiar.
      match /players/{uid} {
        allow read: if true;
        allow create: if isOwner(uid) && onlyKeys(['name', 'at']) && validPlayerName()
          && request.resource.data.at == request.time;
        allow update: if isOwner(uid) && onlyKeys(['name', 'at']) && validPlayerName()
          && request.resource.data.at == resource.data.at;
        allow delete: if isPresenter();
      }

      function validPlayerName() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      }

      // Una respuesta por pregunta: no se puede cambiar después de votar.
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if isOwner(uid)
          && onlyKeys(['q1', 'q1At', 'q2', 'q2At', 'q3', 'q3At'])
          && validAnswer('q1') && validAnswer('q2') && validAnswer('q3');
        allow delete: if isPresenter();
      }

      function validAnswer(q) {
        let d = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return !(q in d)
          || (q in before && before[q] == d[q] && before[q + 'At'] == d[q + 'At'])
          || (!(q in before) && d[q] in ['a', 'b', 'c', 'd'] && (q + 'At') in d && d[q + 'At'] == request.time);
      }

      match /reactions/{uid} {
        allow read: if true;
        allow create: if isOwner(uid) && onlyKeys(['r', 'at', 'n'])
          && request.resource.data.r in ['fire', 'heart', 'mind', 'ask'];
        allow update: if isOwner(uid) && onlyKeys(['r', 'at', 'n'])
          && request.resource.data.r in ['fire', 'heart', 'mind', 'ask']
          && request.time > resource.data.at + duration.value(800, 'ms');
        allow delete: if isPresenter();
      }

      match /questions/{id} {
        allow read, delete: if isPresenter();
        allow create: if request.auth != null
          && onlyKeys(['uid', 'name', 'text', 'slide', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.slide is string && request.resource.data.slide.size() <= 80;
      }

      // Cada persona edita su avatar cuando quiera (cambiarle la gorra al pasar de un día al otro).
      match /avatares/{uid} {
        allow read: if true;
        allow create: if isOwner(uid) && validAvatar() && request.resource.data.hidden == false;
        allow update: if (isOwner(uid) && validAvatar() && request.resource.data.hidden == resource.data.hidden)
          || (isPresenter() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']));
        allow delete: if isOwner(uid) || isPresenter();
      }

      function validAvatar() {
        let d = request.resource.data;
        let o = d.opts;
        return d.keys().hasOnly(['name', 'mensaje', 'opts', 'createdAt', 'hidden'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 24
          && smallInt(d.mensaje, 20)
          && o is map
          && o.keys().hasOnly(['piel', 'pelo', 'colorPelo', 'ropa', 'gorro', 'lentes', 'expresion', 'accesorio', 'companero'])
          && smallInt(o.piel, 12) && smallInt(o.pelo, 12) && smallInt(o.colorPelo, 12)
          && smallInt(o.ropa, 12) && smallInt(o.gorro, 12) && smallInt(o.lentes, 12)
          && smallInt(o.expresion, 12) && smallInt(o.accesorio, 12) && smallInt(o.companero, 12);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
