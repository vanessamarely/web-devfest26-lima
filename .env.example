# ── slides/.env.local (decks + app de asistentes) ─────────────────────────
# Config web de Firebase (no es secreta; la protección son las reglas).
# Sin estas variables los decks funcionan en modo ensayo local (BroadcastChannel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Sesiones: <base>-genui (Día 1) y <base>-agentes (Día 2)
VITE_SESSION_BASE=devfest-lima-2026

# ── URLs publicadas (QR y memoria: nunca localhost) ──────────────────────
VITE_SLIDES_URL=https://devfest-lima-slides.web.app
VITE_DEMO_GENUI_URL=https://devfest-lima-nido.web.app
VITE_DEMO_AGENTES_URL=https://devfest-lima-mesa.web.app
